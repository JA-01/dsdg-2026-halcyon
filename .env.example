# Databricks settings for tools/databricks/bootstrap.py.
# Copy to .env (git ignores it) and fill in your own workspace. Only the
# Databricks pipeline needs these; the local backtests and submission builds don't.
#
# Sign in once; the CLI stores the OAuth credentials in ~/.databrickscfg, not here:
#   set -a; . ./.env; set +a
#   databricks auth login --host "$DATABRICKS_HOST" --profile "$DATABRICKS_CONFIG_PROFILE"

# Workspace URL, for example https://dbc-xxxxxxxx-xxxx.cloud.databricks.com
DATABRICKS_HOST=

# CLI/SDK profile that holds the credentials for that workspace
DATABRICKS_CONFIG_PROFILE=halcyon

# Optional: reuse an existing submission job instead of creating one
HALCYON_DATABRICKS_JOB_ID=
